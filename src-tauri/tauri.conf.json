{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mac-touchpad",
  "identifier": "xiao.luy.mac-touchpad",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MacTouchpad 设置",
        "width": 900,
        "height": 650,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English",
          "TradChinese",
          "Japanese"
        ],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "SimpChinese": "nsis/SimpChinese.nsh"
        }
      }
    }
  }
}